{
  "name": "gaiagis-viewer",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:release": "tsc --noEmit && node scripts/build-release.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "preview:release": "vite preview --host 127.0.0.1 --port 5175 --strictPort --outDir dist-release",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "assets:measure": "node scripts/measure-assets.mjs",
    "notices": "node scripts/notices.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/three": "0.186.0",
    "d3-geo": "3.1.1",
    "d3-geo-projection": "4.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
